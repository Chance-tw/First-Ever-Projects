void player(){
    string playermove;
    bool correctinput=true;
    int rowindex;
    int columnindex;
    string s_or_m;
    //asks for the player to select single or multiplayer until a valid input is given
    while (singleormulti){
        cout<<"Single or multi player: ";
        getline(cin, s_or_m);
        if (s_or_m.length()==1){
            if (s_or_m=="M" || s_or_m=="m"){
                multiplayer=true;
                singleplayer=false;
                singleormulti=false;
                playerturn=1;
                clearterm();
                createboard();
                break;
            }
            else if (s_or_m=="S" || s_or_m=="s"){
                singleplayer=true;
                multiplayer=false;
                playerturn=1;
                singleormulti=false;
                string firstmove;
                cout<<"Play as X (Y/N): ";
                getline(cin, firstmove);
                if (firstmove.length()==1){
                    if (firstmove=="N" || firstmove=="n"){
                        botfirst=true;
                    }
                    else if (firstmove=="X" || firstmove=="x"){
                        exit(0);
                    }
                    else if (firstmove=="Y" || firstmove=="y"){
                        botfirst=false;
                    }
                    else{
                        cout<<"Invalid input!\n";
                        continue;
                    }
                }
                else{
                    cout<<"Invalid input!\n";
                    continue;
                }
                clearterm();
                createboard();
                break;
            }
            else if (s_or_m=="X" || s_or_m=="x"){
                exit(0);
            }
            else{
                cout<<"Invalid input!\n";
            }
        }
        else{
            cout<<"Invalid input!\n";
        }
    }
    //asks until a valid player input is given
    while (correctinput){
        //gives the current players move
        if (playerturn==1){
            //bot as x
            if (botfirst && singleplayer){
                bot();
                break;
            } 
            //player as x
            else{
                cout<<"X's move: ";
                getline(cin, playermove);
            }
        }
        else if (playerturn==2){
            //bot as o
            if (singleplayer && !botfirst){
                bot();
                break;
            }
            //player as o
            else{
                cout<<"O's move: ";
                getline(cin, playermove);
            }
        }
        //cheacks if input is valid and sets the board space to the current players turn if the input is valid
        if (playermove.length()==2){
            char row=playermove[0];
            char column=playermove[1];
            bool correctrow=false;
            bool correctcolumn=false;
            bool msgsent=false;
            switch (row){
                case 'T':
                case 't':
                    rowindex = 0;
                    correctrow=true;
                    break;
                case 'M':
                case 'm':
                    rowindex = 2;
                    correctrow=true;
                    break;
                case 'B':
                case 'b':
                    rowindex = 4;
                    correctrow=true;
                    break;
                default:
                    cout<<"Invalid input!\n";
                    msgsent=true;
                    break;
            }
            switch (column){
                case 'L':
                case 'l':
                    columnindex=0;
                    correctcolumn=true;
                    break;
                case 'M':
                case 'm':
                    columnindex=1;
                    correctcolumn=true;
                    break;
                case 'R':
                case 'r':
                    columnindex=2;
                    correctcolumn=true;
                    break;
                default:
                    if (!msgsent){
                        cout<<"Invalid input!\n";
                        break;
                    }
            }
            if (correctcolumn && correctrow){
                if (board[rowindex][columnindex]==0 && board[rowindex+1][columnindex]==0){
                    board[rowindex][columnindex]=playerturn;
                    board[rowindex+1][columnindex]=playerturn;
                    correctinput=false;
                    playerturn++;
                    if (playerturn==3){
                        playerturn=1;
                    }
                }
                else{
                    cout<<"That spot is taken!\n";
                }
            }
        }
        else if (playermove=="C" || playermove=="c"){
            if (board[2][1]==0 && board[3][1]==0){
                board[2][1]=playerturn;
                board[3][1]=playerturn;
                playerturn++;
                if (playerturn==3){
                    playerturn=1;
                }
                correctinput=false;
            }
            else{
                cout<<"That spot is taken!\n";
            }
        }
        else{
            if (playermove=="x" || playermove=="X"){
                exit(0);
            }
            cout<<"Invalid input!\n";
        }
    }
}

int gameoutcome(){
    bool boardhasempty=false;
    bool boardempty=true;
    //checks if the board is completely empty or just has some empty spots left
    for (int row=0;row<6;row+=2){
        for (int col=0;col<3;col++){
            if (board[row][col]!=0){
                boardempty=false;
            }
            else{
                boardhasempty=true;
            }
        }
    }
    //returns an integer corresponding to an outcome
    if (boardempty){
        //board is completely empty
        return 0;
    }
    for (int row=0;row<6;row+=2){
        if (board[row][0]==board[row][1] && board[row][1]==board[row][2] && board[row][0]!=0){
            //returns the integer corresponding to the player that won on a horizontal
            return board[row][0];
        }
    }
    for (int col=0;col<3;col++){
        if (board[0][col]==board[2][col] && board[2][col]==board[4][col] && board[0][col]!=0){
            //returns the integer corresponding to the player that won on a vertical
            return board[0][col];
        }
    }
    //returns the integer corresponding to the player that won on a diagonal
    if (board[0][0]==board[2][1] && board[2][1]==board[4][2] && board[0][0]!=0){
        return board[0][0];
    }
    else if (board[0][2]==board[2][1] && board[2][1]==board[4][0] && board[0][2]!=0){
        return board[0][2];
    }
    else if (boardhasempty){
        return 4;
    }
    return 3;
}

