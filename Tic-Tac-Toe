}

int cornercheck(int botXorO){
    //checks corners for the bot
    int cornersXorO[]={board[0][0], board[0][2], board[4][0], board[4][2]};
    int opponent;
    if (botXorO==1){
        opponent=2;
    }
    else{
        opponent=1;
    }
    for (int i=0;i<4;i++){
        if (cornersXorO[i]==opponent){
            return 1;
        }
    }
    return 0;
}

void randcorner(int botXorO){
    //selects a random corner for the bot to play in
    while (true){
        int corner=rand()%4;
        if (corner==0 && board[0][0]==0){
            board[0][0]=botXorO;
            board[1][0]=botXorO;
            break;
        }
        else if (corner==1 && board[0][2]==0){
            board[0][2]=botXorO;
            board[1][2]=botXorO;
            break;
        }
        else if (corner==2 && board[4][0]==0){
            board[4][0]=botXorO;
            board[5][0]=botXorO;
            break;
        }
        else if (corner==3 && board[4][2]==0){
            board[5][2]=botXorO;
            board[4][2]=botXorO;
            break;
        }
    }
}

void bot(){
    int randrow;
    int randcolumn;
    int botoutput;
    int winpos=wincondpos();
    //checks if the bot is x or o
    if (botfirst){
        botoutput=1;
    }
    else{
        botoutput=2;
    }
    if (singleplayer && playerturn==botoutput){
        if (winpos!=0){
            //wins and then blocks
            if (botoutput==1){
                xprioritize(botoutput, winpos);
            }
            else if (botoutput==2){
                oprioritize(botoutput, winpos);
            }
        }
        else if (cornercheck(botoutput)==1 && board[2][1]==0){
            //plays a random corner or the center
            int cornerorcenter=rand()%2;
            if (cornerorcenter==0){
                board[2][1]=botoutput;
                board[3][1]=botoutput;
            }
            else if (cornerorcenter==1){
                randcorner(botoutput);
            }
        }
        else if (gameoutcome()==0){
            randcorner(botoutput);
        }
        else{
            //random move
            while (true){
                randrow=(rand()%3)*2;
                randcolumn=rand()%3;
                if (board[randrow][randcolumn]==0){
                    board[randrow][randcolumn]=botoutput;
                    board[randrow+1][randcolumn]=botoutput;
                    break;
                }
            }
        }
    }
    if (botoutput==2){
        playerturn=1;
    }
    else{
        playerturn=2;
    }
}

