void oprioritize(int botoutput, int winpos){
    //moves for the bot if it is playing as o
    if (winpos==1){
        int row=overtwincond().first;
        int column=overtwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
    else if (winpos==2){
        int row=ohorwincond().first;
        int column=ohorwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
    else if (winpos==3){
        int row=odiagwincond().first;
        int column=odiagwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
    else if (winpos==4){
        int row=xvertwincond().first;
        int column=xvertwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
    else if (winpos==5){
        int row=xhorwincond().first;
        int column=xhorwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
    else if (winpos==6){
        int row=xdiagwincond().first;
        int column=xdiagwincond().second;
        board[row][column]=botoutput;
        board[(row+1)][column]=botoutput;
    }
}

void xprioritize(int botoutput, int winpos){
    //moves for the bot if it is playing as x
    if (winpos==4){
        int row=xvertwincond().first;
        int column=xvertwincond().second;
        board[row][column]=botoutput;
